# ==============================================================================
# TOKEN DISPLAY ENVIRONMENT VARIABLES
# Salin file ini menjadi .env untuk penggunaan lokal (local development).
# Atur variabel ini pada menu Environment Variables di Project Settings Vercel.
# ==============================================================================

# 1. Konfigurasi Client-Side (Vite Frontend)
# Variabel dengan awalan VITE_ akan disertakan dalam build browser.
# HANYA gunakan Anon Key di sini, JANGAN PERNAH gunakan Service Role Key!
VITE_SUPABASE_URL=https://xyzcompany.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.anon_key_example

# 2. Konfigurasi Server-Side (Vercel Serverless Function & Dev Server)
# Variabel rahasia ini HANYA boleh diakses di sisi server (api/token.js).
# JANGAN berikan awalan VITE_ agar tidak bocor ke browser bundle.
SUPABASE_URL=https://xyzcompany.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.service_role_key_example

# Kunci rahasia otorisasi admin untuk memperbarui token melalui /api/token
ADMIN_SECRET=ganti_dengan_kunci_rahasia_admin_yang_kuat_123!
